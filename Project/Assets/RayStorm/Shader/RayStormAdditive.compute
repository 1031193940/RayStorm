
#pragma kernel CSKernelMain

#include "Include/DataInclude.cginc"

uint RaytraceWindowPosX;
uint RaytraceWindowPosY;
uint RaytraceWindowSizeX;
uint RaytraceWindowSizeY;
uint SubpixelCountPerPixel;
StructuredBuffer<RSOutputData> RaytraceWindowBuffer;
RWTexture2D<float4> RaytraceOutputTexture;

[numthreads(1024, 1, 1)]
void CSKernelMain(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= RaytraceWindowSizeX * RaytraceWindowSizeY)
		return;

	uint PixelID = id.x;
	uint SubpixelStartID = PixelID * SubpixelCountPerPixel;

	float4 RaytraceColor = 0.0f;
	for (uint LocalID = 0; LocalID < SubpixelCountPerPixel; ++LocalID)
	{
		uint SubpixelID = SubpixelStartID + LocalID;
		RaytraceColor += RaytraceWindowBuffer[SubpixelID].data * rcp(SubpixelCountPerPixel);
	}

	uint2 TexturePixelID = int2(RaytraceWindowPosX, RaytraceWindowPosY) + int2(PixelID % RaytraceWindowSizeX, PixelID / RaytraceWindowSizeX);
	
	float3 Color = (RaytraceOutputTexture[TexturePixelID].rgb * RaytraceOutputTexture[TexturePixelID].a + RaytraceColor.rgb);
	float  Alpha = RaytraceOutputTexture[TexturePixelID].a + 1.0;
	RaytraceOutputTexture[TexturePixelID] = float4(Color / Alpha, Alpha);
}