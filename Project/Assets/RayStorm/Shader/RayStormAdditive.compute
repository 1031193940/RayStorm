#pragma kernel CSKernelMain
#include "Include/DataInclude.cginc"

uint RaytraceWindowPosX;
uint RaytraceWindowPosY;
uint RaytraceWindowSizeX;
uint RaytraceWindowSizeY;
uint SubpixelCountPerPixel;
StructuredBuffer<RSOutputData> RaytraceWindowBuffer;
RWTexture2D<float4> RaytraceOutputTexture;

[numthreads(128, 1, 1)]
void CSKernelMain(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= RaytraceWindowSizeX * RaytraceWindowSizeY)
		return;

	uint2 TexturePixelID = uint2(RaytraceWindowPosX, RaytraceWindowPosY)
		+ uint2(id.x % RaytraceWindowSizeX, id.x / RaytraceWindowSizeX);
	uint TextureWidth, TextureHeight;
	RaytraceOutputTexture.GetDimensions(TextureWidth, TextureHeight);
	if (TexturePixelID.x >= TextureWidth || TexturePixelID.y >= TextureHeight)
		return;

	uint SubpixelStartID = id.x * SubpixelCountPerPixel;
	float3 SampleSum = 0.0f;
	for (uint SampleID = 0; SampleID < SubpixelCountPerPixel; ++SampleID)
		SampleSum += RaytraceWindowBuffer[SubpixelStartID + SampleID].data.rgb;

	// RGB: linear mean. A: sample count.
	float4 Previous = RaytraceOutputTexture[TexturePixelID];
	float SampleCount = Previous.a + SubpixelCountPerPixel;
	float3 Mean = (Previous.rgb * Previous.a + SampleSum) / SampleCount;
	RaytraceOutputTexture[TexturePixelID] = float4(Mean, SampleCount);
}
