#pragma kernel CSKernelMain

uint BlockPosX;
uint BlockPosY;
uint BlockSizeX;
uint BlockSizeY;
int ShowRenderBlock;
int ShowRenderProgress;
float RenderProgress;
int OutputIsGamma;
Texture2D<float4> Source;
RWTexture2D<float4> Target;

float3 LinearToSRGB(float3 Color)
{
	float3 Low = Color * 12.92f;
	float3 High = 1.055f * pow(Color, 1.0f / 2.4f) - 0.055f;
	return float3(Color.r <= 0.0031308f ? Low.r : High.r,
		Color.g <= 0.0031308f ? Low.g : High.g,
		Color.b <= 0.0031308f ? Low.b : High.b);
}

[numthreads(8, 8, 1)]
void CSKernelMain(uint3 id : SV_DispatchThreadID)
{
	uint TargetWidth, TargetHeight;
	Target.GetDimensions(TargetWidth, TargetHeight);
	if (id.x >= TargetWidth || id.y >= TargetHeight)
		return;

	float3 Radiance = max(Source[id.xy].rgb, 0.0f);
	float3 DisplayColor = Radiance / (1.0f + Radiance);
	if (OutputIsGamma != 0)
		DisplayColor = LinearToSRGB(DisplayColor);

	if (ShowRenderBlock != 0 && id.x >= BlockPosX && id.x - BlockPosX < BlockSizeX
		&& id.y >= BlockPosY && id.y - BlockPosY < BlockSizeY)
	{
		uint2 BlockSize = uint2(BlockSizeX, BlockSizeY);
		uint2 Position = id.xy - uint2(BlockPosX, BlockPosY);
		uint2 EdgeDistance = min(Position, BlockSize - 1u - Position);
		uint2 CornerSize = min(uint2(8, 8), max(uint2(1, 1), (max(BlockSize, uint2(3, 3)) - 3u) / 3u));
		uint Inset = min(1u, (min(BlockSizeX, BlockSizeY) - 1u) / 2u);
		bool Corner = (EdgeDistance.x == Inset && EdgeDistance.y >= Inset && EdgeDistance.y < Inset + CornerSize.y) || (EdgeDistance.y == Inset && EdgeDistance.x >= Inset && EdgeDistance.x < Inset + CornerSize.x);
		bool Outline = (EdgeDistance.x <= Inset + 1u && EdgeDistance.y < Inset + CornerSize.y + 1u) || (EdgeDistance.y <= Inset + 1u && EdgeDistance.x < Inset + CornerSize.x + 1u);
		if (Outline)
			DisplayColor = Corner ? 1.0f : 0.0f;
	}
	if (ShowRenderProgress != 0 && id.y < min(3u, TargetHeight))
		DisplayColor = id.y < min(2u, TargetHeight) && id.x < (uint)(saturate(RenderProgress) * TargetWidth) ? 1.0f : 0.0f;

	Target[id.xy] = float4(DisplayColor, 1.0f);
}
