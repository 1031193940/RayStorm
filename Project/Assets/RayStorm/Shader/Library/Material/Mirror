
float3 OnMaterialRayIntersectProgram(in RSMaterialData MaterialData, inout RSRayData Ray, in RSRayIntersectData RayIntersectData)
{
    float3 Normal = RayIntersectData.normal;
    Normal = CorrectGeometryNormal(-Ray.direction, Normal);
    Normal = RoughnessNormal(Ray.id, Normal, MaterialData.roughness);

    Ray.energy *= MaterialData.albedo;
    Ray.direction = normalize(reflect(Ray.direction, Normal));
    Ray.position = RayIntersectData.position + Normal * RAYTRACE_EPSILON;

    return MaterialData.emission;
}

float3 OnMaterialLightShadeProgram(in RSMaterialData MaterialData, in RSLightData LightData, float3 N, float3 L, float3 V, float Shadow)
{
    float3 H = normalize(L + V);

    float NdotL = saturate(dot(N, L));
    float NdotV = saturate(dot(N, V));
    float NdotH = saturate(dot(N, H));
    float VdotH = saturate(dot(V, H));
    
    return BRDF(0.04, NdotL, NdotV, NdotH, VdotH, MaterialData.roughness) * MaterialData.albedo * LightData.color * Shadow;
}