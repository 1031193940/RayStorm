
float3 OnMaterialRayIntersectProgram(in RSMaterialData MaterialData, inout RSRayData Ray, in RSRayIntersectData RayIntersectData)
{
    float3 NormalDirection = RayIntersectData.normal;
    if (dot(NormalDirection, -Ray.direction) < 0.0f)
        NormalDirection = -NormalDirection;

    Ray.energy = 0.0f;
    return NormalDirection;
}

