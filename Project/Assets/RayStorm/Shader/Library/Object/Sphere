
float SampleSphereDistanceFieldValue(float3 Position, float3 Center, float Radius)
{
    return distance(Position, Center) - Radius;
}

float3 SampleSphereDistanceFieldNormal(float3 Position, float3 Center, float Radius)
{
    const float2 kEpsilon = float2(0.00001f, 0.0f);
	float DDX = SampleSphereDistanceFieldValue(Position - kEpsilon.xyy, Center, Radius);
	float DDY = SampleSphereDistanceFieldValue(Position - kEpsilon.yxy, Center, Radius);
	float DDZ = SampleSphereDistanceFieldValue(Position - kEpsilon.yyx, Center, Radius);
	float3 Normal = SampleSphereDistanceFieldValue(Position, Center, Radius) - float3(DDX, DDY, DDZ);
	return Normal;
}

bool OnObjectRayHitProgram(in RSObjectData ObjectData, in RSRayData Ray, inout RSRayIntersectData RayIntersectData)
{
    const int kRaytraceStepsMax = 256;

    float Radius = ObjectData.scale * 0.5f;

    float RaytraceDistance = 0.0f;
    for (int StepID = 0; StepID < kRaytraceStepsMax; ++StepID)
    {
        float3 RaytracePosition = Ray.position + Ray.direction * RaytraceDistance;

        float DistanceField = SampleSphereDistanceFieldValue(RaytracePosition, ObjectData.position, Radius);
        if (DistanceField < RAYTRACE_EPSILON)
        {
            RayIntersectData.materialID = ObjectData.materialID;
            RayIntersectData.position = RaytracePosition;
            RayIntersectData.normal = normalize(SampleSphereDistanceFieldNormal(RaytracePosition, ObjectData.position, Radius));
            break;
        }

        RaytraceDistance += DistanceField;
        if (RaytraceDistance > RAYTRACE_MAX_DISTANCE)
        {
            RayIntersectData = (RSRayIntersectData)0;
            break;
        }
    }

    return RaytraceDistance < RAYTRACE_MAX_DISTANCE;
}