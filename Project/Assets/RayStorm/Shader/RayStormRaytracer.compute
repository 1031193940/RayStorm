#include "Include/DataInclude.cginc"
#include "Include/MathInclude.cginc"
#include "Include/RandomInclude.cginc"
#include "Include/ConfigInclude.cginc"
#include "Include/SceneInclude.cginc"
#include "Include/ShadeInclude.cginc"

#pragma kernel CSKernelMain

uint RayCount;
uint RSRandomSeed;
StructuredBuffer<RSSourceData> RayStormSourceBuffer;
RWStructuredBuffer<RSOutputData> RayStormOutputBuffer;

[numthreads(128, 1, 1)]
void CSKernelMain(uint3 id : SV_DispatchThreadID)
{
	if (id.x >= RayCount)
		return;

	RSSourceData Source = RayStormSourceBuffer[id.x];
	RSRayData Ray = (RSRayData)0;
	Ray.id = Source.id;
	Ray.position = Source.position;
	Ray.direction = Source.direction;
	Ray.energy = Source.energy;
	Ray.randomState = InitializeRandomState(id.x, RSRandomSeed);

	float3 RaytraceColor = 0.0f;
	for (int BounceID = 0; BounceID < RAYTRACE_MAX_BOUNCES; ++BounceID)
	{
		RSRayIntersectData RayIntersectData;
		float3 IncomingEnergy = Ray.energy;
		float3 EmittedRadiance;
		if (FindClosestRayHit(Ray, RayIntersectData))
			EmittedRadiance = RayHitSurface(Ray, RayIntersectData);
		else
			EmittedRadiance = RayHitSkybox(Ray, RayIntersectData);

		RaytraceColor += IncomingEnergy * EmittedRadiance;
		if (dot(Ray.energy, 1.0f) < RAYTRACE_EPSILON)
			break;
	}

	RayStormOutputBuffer[id.x].data = float4(RaytraceColor, 1.0f);
}